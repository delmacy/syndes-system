# Build is performed by trusted CI on a supported CPU.
# This runtime-only image consumes the vetted static bundle as an explicit
# BuildKit named context: --build-context web-dist=/path/to/dist
FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY apps/master-admin-web/deploy/default.conf /etc/nginx/conf.d/default.conf
COPY --from=web-dist / /usr/share/nginx/html/
EXPOSE 8080
