# Internal Docker address, never exposed to browsers
GATEWAY_INTERNAL_URL=http://gateway:8080
GATEWAY_ADMIN_TOKEN=REPLACE_WITH_SAME_GATEWAY_SECRET

# Keycloak OIDC (frontend admin realm client)
AUTH_SECRET=REPLACE_WITH_RANDOM_32PLUS_BYTES
AUTH_KEYCLOAK_ID=syndes-whatsapp-admin
AUTH_KEYCLOAK_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
AUTH_KEYCLOAK_ISSUER=https://your-keycloak-domain/realms/syndes
AUTH_ADMIN_ROLE=syndes-gateway-admin
AUTH_TRUST_HOST=true
