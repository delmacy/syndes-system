# Generate with: openssl rand -base64 48
# Do not commit actual tokens.
GATEWAY_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional Keycloak service JWT verification (all 3 required together).
# When configured, static GATEWAY_ADMIN_TOKEN no longer grants access.
# GATEWAY_ISSUER=https://keycloak.example.com/realms/syndes
# GATEWAY_AUDIENCE=syndes-whatsapp-gateway
# GATEWAY_JWKS_URL=https://keycloak.example.com/realms/syndes/protocol/openid-connect/certs
