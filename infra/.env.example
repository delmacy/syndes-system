# Shared environment for three independent Compose projects. Copy to infra/.env (gitignored).
# Use distinct high-entropy secrets. Never deploy this example as-is.
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_RANDOM_SECRET
PG_KEYCLOAK_PASSWORD=REPLACE_WITH_ANOTHER_SECRET
PG_OPENFGA_PASSWORD=REPLACE_WITH_ANOTHER_SECRET
PG_CORE_PASSWORD=REPLACE_WITH_ANOTHER_SECRET
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=syndes-bootstrap
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_PUBLIC_URL=https://auth.example.com
# URL-encode any special characters in passwords embedded inside URIs.
OPENFGA_DATASTORE_URI=postgres://syndes_openfga:URL_ENCODED_PASSWORD@syndes-postgres:5432/syndes_openfga?sslmode=disable
OPENFGA_PRESHARED_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
CORE_CONTROL_DB_URL=postgres://syndes_core:URL_ENCODED_PASSWORD@syndes-postgres:5432/syndes_control?sslmode=disable
CORE_KEYCLOAK_ISSUER=https://auth.example.com/realms/syndes
CORE_KEYCLOAK_AUDIENCE=syndes-core
CORE_KEYCLOAK_JWKS_URL=https://auth.example.com/realms/syndes/protocol/openid-connect/certs
# Set only after provisioning an OpenFGA store + model.
CORE_OPENFGA_STORE_ID=REPLACE_WITH_STORE_ID
