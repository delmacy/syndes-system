-- AK-30.01 — CANDIDATE, tenant DB ONLY. Apply solely through an authorized
-- privileged installer with a vetted release digest; never through Host runtime.
-- This bootstrap has no DROP CASCADE and can be re-applied without erasing history.
CREATE SCHEMA IF NOT EXISTS _syndes;
REVOKE ALL ON SCHEMA _syndes FROM PUBLIC;
CREATE TABLE IF NOT EXISTS _syndes.module_migrations (
  module_id TEXT NOT NULL
    CHECK (module_id ~ '^[a-z][a-z0-9_]*$' AND length(module_id)<=63),
  migration_id TEXT NOT NULL
    CHECK (migration_id ~ '^[0-9]{3}_[a-z0-9_]+$' AND length(migration_id)<=120),
  version TEXT NOT NULL
    CHECK (version ~ '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' AND length(version)<=80),
  checksum TEXT NOT NULL CHECK(checksum ~ '^[0-9a-f]{64}$'),
  image_digest TEXT NOT NULL CHECK(image_digest ~ '^sha256:[0-9a-f]{64}$'),
  applied_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
  PRIMARY KEY(module_id,migration_id)
);
-- A connection as the regular tenant runtime role MUST NOT be able to read,
-- INSERT or UPDATE the protected migration history.
REVOKE ALL ON _syndes.module_migrations FROM PUBLIC;
