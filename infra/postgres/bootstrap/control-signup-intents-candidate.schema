-- UC-SIGNUP-01B: operator-only Control intent BEFORE tenant/DB creation.
-- Candidate migration; never installed by Core Host startup or HTTP requests.
-- No browser, tenant runtime or Manager identity receives this role.
DO $role$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='syndes_signup_operator')
 THEN CREATE ROLE syndes_signup_operator NOLOGIN; END IF;
END $role$;

CREATE TABLE IF NOT EXISTS public.platform_signup_intents (
 request_id UUID PRIMARY KEY,
 founder_id UUID NOT NULL,
 tenant_id UUID NOT NULL UNIQUE,
 organization_id UUID NOT NULL UNIQUE,
 workspace_id UUID NOT NULL UNIQUE,
 account_name TEXT NOT NULL CHECK(length(btrim(account_name)) BETWEEN 2 AND 160),
 organization_name TEXT NOT NULL CHECK(length(btrim(organization_name)) BETWEEN 2 AND 160),
 workspace_name TEXT NOT NULL CHECK(length(btrim(workspace_name)) BETWEEN 2 AND 160),
 keycloak_alias TEXT NOT NULL UNIQUE CHECK(keycloak_alias ~ '^syndes-[0-9a-f]{32}-[0-9a-f]{32}
 state TEXT NOT NULL DEFAULT 'reserved'
   CHECK(state IN ('reserved','reconcile_required','ready')),
 revision BIGINT NOT NULL DEFAULT 1 CHECK(revision>0),
 created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
 changed_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp()
);
-- No FK to tenant_registry yet: the whole purpose is to reserve BEFORE the
-- dedicated operator installer creates the tenant and its database.
CREATE INDEX IF NOT EXISTS platform_signup_intents_founder
 ON public.platform_signup_intents(founder_id,created_at,request_id);

CREATE TABLE IF NOT EXISTS public.platform_signup_intent_audit (
 event_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
 request_id UUID NOT NULL REFERENCES public.platform_signup_intents(request_id)
  ON DELETE RESTRICT,
 revision BIGINT NOT NULL CHECK(revision>0),
 event TEXT NOT NULL CHECK(event IN ('reserved','reconcile_required','ready')),
 occurred_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
 UNIQUE(request_id,revision)
);
REVOKE ALL ON public.platform_signup_intents,
 public.platform_signup_intent_audit FROM PUBLIC,syndes_core;
REVOKE ALL ON SEQUENCE public.platform_signup_intent_audit_event_id_seq
 FROM PUBLIC,syndes_core;
GRANT USAGE ON SCHEMA public TO syndes_signup_operator;
GRANT SELECT,INSERT ON public.platform_signup_intents TO syndes_signup_operator;
GRANT UPDATE(state,revision,changed_at,keycloak_organization_id) ON public.platform_signup_intents
 TO syndes_signup_operator;
GRANT SELECT,INSERT ON public.platform_signup_intent_audit TO syndes_signup_operator;
GRANT USAGE,SELECT ON SEQUENCE public.platform_signup_intent_audit_event_id_seq
 TO syndes_signup_operator;
-- No tenant DB creation, Keycloak/FGA grants or Control tenant_registry writes.
),
 keycloak_organization_id UUID UNIQUE,
 state TEXT NOT NULL DEFAULT 'reserved'
   CHECK(state IN ('reserved','reconcile_required','ready')),
 revision BIGINT NOT NULL DEFAULT 1 CHECK(revision>0),
 created_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
 changed_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp()
);
-- No FK to tenant_registry yet: the whole purpose is to reserve BEFORE the
-- dedicated operator installer creates the tenant and its database.
CREATE INDEX IF NOT EXISTS platform_signup_intents_founder
 ON public.platform_signup_intents(founder_id,created_at,request_id);

CREATE TABLE IF NOT EXISTS public.platform_signup_intent_audit (
 event_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
 request_id UUID NOT NULL REFERENCES public.platform_signup_intents(request_id)
  ON DELETE RESTRICT,
 revision BIGINT NOT NULL CHECK(revision>0),
 event TEXT NOT NULL CHECK(event IN ('reserved','reconcile_required','ready')),
 occurred_at TIMESTAMPTZ NOT NULL DEFAULT clock_timestamp(),
 UNIQUE(request_id,revision)
);
REVOKE ALL ON public.platform_signup_intents,
 public.platform_signup_intent_audit FROM PUBLIC,syndes_core;
REVOKE ALL ON SEQUENCE public.platform_signup_intent_audit_event_id_seq
 FROM PUBLIC,syndes_core;
GRANT USAGE ON SCHEMA public TO syndes_signup_operator;
GRANT SELECT,INSERT ON public.platform_signup_intents TO syndes_signup_operator;
GRANT UPDATE(state,revision,changed_at) ON public.platform_signup_intents
 TO syndes_signup_operator;
GRANT SELECT,INSERT ON public.platform_signup_intent_audit TO syndes_signup_operator;
GRANT USAGE,SELECT ON SEQUENCE public.platform_signup_intent_audit_event_id_seq
 TO syndes_signup_operator;
-- No tenant DB creation, Keycloak/FGA grants or Control tenant_registry writes.
