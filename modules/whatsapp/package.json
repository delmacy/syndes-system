{
  "name": "@syndes/whatsapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Syndes WhatsApp accounts and provider-independent contracts",
  "main": "./dist/accounts.js",
  "exports": {
    ".": "./dist/accounts.js",
    "./contracts": "./dist/contracts/index.js",
    "./plugin": "./dist/plugin.js",
    "./crm-link-plan": {
      "types": "./dist/crm-link-plan.d.ts",
      "default": "./dist/crm-link-plan.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist",
    "sql",
    "gateway",
    "README.md"
  ],
  "devDependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@types/node": "22.18.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@syndes/core-kernel": "file:../../packages/core-kernel"
  },
  "peerDependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
